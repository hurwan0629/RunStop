{
  "name": "runstop-backend",
  "version": "1.0.0",
  "description": "backend node api server for \"RunStop\" service",
  "keywords": [
    "RunStop"
  ],
  "homepage": "https://github.com/hurwan0629/RunStop#readme",
  "bugs": {
    "url": "https://github.com/hurwan0629/RunStop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hurwan0629/RunStop.git"
  },
  "license": "ISC",
  "author": "hurwa",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "test": "cross-env NODE_ENV=test vitest",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node-pg-migrate up -m ../infra/db/migrations",
    "db:migrate:down": "node-pg-migrate down -m ../infra/db/migrations",
    "db:migration:create": "node-pg-migrate create -m ../infra/db/migrations"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
